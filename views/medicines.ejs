<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>KhaayaKya — Medicines</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen">

  <!-- NAVBAR -->
  <nav class="bg-white shadow-sm border-b border-gray-200">
    <div class="max-w-5xl mx-auto px-6 py-4 flex justify-between items-center">
      <div class="flex items-center gap-2">
        <span class="text-2xl">💊</span>
        <h1 class="text-xl font-bold text-gray-800">KhaayaKya</h1>
      </div>
      <div class="flex items-center gap-4">
        <a href="/parents" class="text-blue-600 hover:text-blue-700 text-sm font-medium">
          ← Back to Parents
        </a>
        <a href="/logout"
           class="bg-red-500 hover:bg-red-600 text-white text-sm px-4 py-2 rounded-lg transition">
          Logout
        </a>
      </div>
    </div>
  </nav>

  <div class="max-w-5xl mx-auto px-6 py-8">
    <h2 class="text-2xl font-bold text-gray-800 mb-1">
      💊 <%= parent.name %>'s Medicines
    </h2>
    <p class="text-gray-500 text-sm mb-6">
      <%= parent.relationship %> · <%= parent.phone %>
    </p>

    <!-- ADD MEDICINE FORM -->
    <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm mb-8">
      <h3 class="text-lg font-bold text-gray-800 mb-4">Add New Medicine</h3>
      <form action="/medicines/add" method="POST" class="space-y-4">
        <input type="hidden" name="parentId" value="<%= parent._id %>"/>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Medicine Name</label>
            <input type="text" name="name" required placeholder="e.g. Metformin"
                   class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm
                          focus:outline-none focus:ring-2 focus:ring-blue-500"/>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Dosage</label>
            <input type="text" name="dosage" required placeholder="e.g. 500mg"
                   class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm
                          focus:outline-none focus:ring-2 focus:ring-blue-500"/>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">
              Times (comma separated)
            </label>
            <input type="text" name="times" required placeholder="e.g. 09:00, 21:00"
                   class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm
                          focus:outline-none focus:ring-2 focus:ring-blue-500"/>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">With Food?</label>
            <select name="withFood"
                    class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm
                           focus:outline-none focus:ring-2 focus:ring-blue-500">
              <option value="true">After Food</option>
              <option value="false">Before Food</option>
            </select>
          </div>
        </div>
        <button type="submit"
                class="bg-blue-600 hover:bg-blue-700 text-white font-semibold
                       px-6 py-2.5 rounded-lg transition text-sm">
          Add Medicine →
        </button>
      </form>
    </div>

    <!-- MEDICINES LIST -->
    <% if (medicines.length === 0) { %>
      <div class="bg-white rounded-xl border border-gray-200 p-8 text-center">
        <p class="text-gray-400 text-lg mb-2">No medicines added yet</p>
        <p class="text-gray-400 text-sm">Add medicines above to start tracking</p>
      </div>
    <% } else { %>
      <div class="space-y-3">
        <% medicines.forEach(med => { %>
          <div class="bg-white rounded-xl border border-gray-200 p-5 shadow-sm">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 bg-blue-50 rounded-lg flex items-center 
                            justify-center text-xl">💊</div>
                <div>
                  <h3 class="font-bold text-gray-800">
                    <%= med.name %>
                    <span class="text-gray-500 font-normal text-sm ml-1">
                      <%= med.dosage %>
                    </span>
                  </h3>
                  <p class="text-sm text-gray-500">
                    ⏰ <%= med.times.join(', ') %> ·
                    🍽️ <%= med.withFood ? 'After food' : 'Before food' %>
                  </p>
                </div>
              </div>
              <div class="flex items-center gap-3">
                <span class="text-sm font-medium px-3 py-1 rounded-full
                  <%= med.isActive ? 
                    'bg-green-50 text-green-700' : 
                    'bg-gray-100 text-gray-500' %>">
                  <%= med.isActive ? '✅ Active' : '⛔ Inactive' %>
                </span>
                <form action="/medicines/toggle/<%= med._id %>" method="POST">
                  <button type="submit"
                          class="bg-gray-50 hover:bg-gray-100 text-gray-700 text-sm
                                 font-medium px-3 py-1.5 rounded-lg transition border
                                 border-gray-200">
                    <%= med.isActive ? 'Deactivate' : 'Activate' %>
                  </button>
                </form>
                <form action="/medicines/delete/<%= med._id %>" method="POST">
                  <button type="submit"
                          onclick="return confirm('Delete <%= med.name %>?')"
                          class="bg-red-50 hover:bg-red-100 text-red-600 text-sm
                                 font-medium px-3 py-1.5 rounded-lg transition">
                    🗑️
                  </button>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>KhaayaKya — Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-gradient-to-br from-blue-50 via-white to-purple-50">
  <!-- ─── NAVBAR ──────────────────────────────────── -->
  <nav class="bg-white shadow-sm border-b border-gray-200">
    <div class="max-w-5xl mx-auto px-6 py-4 flex justify-between items-center">
      <div class="flex items-center gap-2">
        <span class="text-2xl">💊</span>
        <h1 class="text-xl font-bold text-gray-800">KhaayaKya</h1>
      </div>
      <div class="flex items-center gap-3 flex-wrap">
        <span class="text-gray-600 text-sm hidden md:block">Welcome, <strong><%= user.name %></strong>!</span>

        <a href="/parents" class="text-blue-600 hover:text-blue-700 text-sm font-medium">
          Manage Parents
        </a>
        <a href="/logout" 
           class="bg-red-500 hover:bg-red-600 text-white text-sm px-4 py-2 rounded-lg transition">
          Logout
        </a>
      </div>
    </div>
  </nav>

  <div class="max-w-5xl mx-auto px-6 py-8">

    <!-- ─── ALERTS ──────────────────────────────────── -->
    <% if (alerts.length > 0) { %>
      <div class="bg-red-50 border border-red-200 rounded-xl p-5 mb-6">
        <div class="flex justify-between items-center mb-3">
          <h2 class="text-lg font-bold text-red-700">
            🔔 Alerts (<%= alerts.length %>)
          </h2>
          <form action="/dashboard/alerts/clear" method="POST">
            <button type="submit"
                    class="text-xs text-red-500 hover:text-red-700 font-medium
                          bg-white border border-red-200 px-3 py-1.5 rounded-lg
                          hover:bg-red-50 transition">
              Clear all ✕
            </button>
          </form>
        </div>
        <div class="space-y-2">
          <% alerts.forEach(alert => { %>
            <div class="bg-white border border-red-100 rounded-lg p-4 flex justify-between items-start">
              <div>
                <p class="text-red-700 font-medium">⚠️ <%= alert.message %></p>
                <small class="text-gray-400">
                  <%= new Date(alert.createdAt).toLocaleString() %>
                </small>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>

    <!-- ─── TODAY'S SCHEDULE ─────────────────────────── -->
    <div class="mb-8">
      <h2 class="text-xl font-bold text-gray-800 mb-4">
        📅 Today's Schedule — <span class="text-blue-600"><%= today %></span>
      </h2>

      <% if (parents.length === 0) { %>
        <div class="bg-white rounded-xl border border-gray-200 p-8 text-center">
          <p class="text-gray-500 mb-3">No parents added yet.</p>
          <a href="/parents" 
             class="bg-blue-500 hover:bg-blue-600 text-white px-5 py-2 rounded-lg text-sm transition">
            Add Parent
          </a>
        </div>
      <% } %>

      <div class="space-y-4">
        <% Object.values(schedule).forEach(item => { %>
          <div class="bg-white rounded-xl border border-gray-200 p-5 shadow-sm">
            <div class="flex justify-between items-center mb-4">
              <h3 class="font-bold text-gray-800 text-lg">
                👴 <%= item.parent.name %>
                <span class="text-sm font-normal text-gray-500">
                  (<%= item.parent.relationship %>)
                </span>
              </h3>
              <a href="/insights/<%= item.parent._id %>"
                 class="text-purple-600 hover:text-purple-700 text-sm font-medium">
                🧠 AI Insights →
              </a>
            </div>

            <% if (item.logs.length === 0) { %>
              <p class="text-gray-400 text-sm">No medicines scheduled for today.</p>
            <% } else { %>
              <div class="space-y-2">
                <% item.logs.forEach(log => { %>
                  <div class="flex items-center gap-4 p-3 rounded-lg bg-gray-50">
                    <% if (log.status === 'taken') { %>
                      <span class="text-2xl">✅</span>
                      <div class="flex-1">
                        <p class="font-medium text-gray-800">
                          <%= log.medicineId.name %>
                          <span class="text-gray-500 font-normal">
                            <%= log.medicineId.dosage %>
                          </span>
                        </p>
                        <p class="text-sm text-gray-400">
                          Scheduled: <%= log.scheduledTime %>
                          <% if (log.respondedAt) { %>
                            · Taken at <%= new Date(log.respondedAt).toLocaleTimeString() %>
                          <% } %>
                        </p>
                      </div>
                      <span class="text-green-600 text-sm font-medium bg-green-50 
                                   px-3 py-1 rounded-full">Taken</span>
                    <% } else if (log.status === 'missed') { %>
                      <span class="text-2xl">❌</span>
                      <div class="flex-1">
                        <p class="font-medium text-gray-800">
                          <%= log.medicineId.name %>
                          <span class="text-gray-500 font-normal">
                            <%= log.medicineId.dosage %>
                          </span>
                        </p>
                        <p class="text-sm text-gray-400">
                          Scheduled: <%= log.scheduledTime %>
                        </p>
                      </div>
                      <span class="text-red-600 text-sm font-medium bg-red-50 
                                   px-3 py-1 rounded-full">Missed</span>
                    <% } else { %>
                      <span class="text-2xl">⏳</span>
                      <div class="flex-1">
                        <p class="font-medium text-gray-800">
                          <%= log.medicineId.name %>
                          <span class="text-gray-500 font-normal">
                            <%= log.medicineId.dosage %>
                          </span>
                        </p>
                        <p class="text-sm text-gray-400">
                          Scheduled: <%= log.scheduledTime %>
                        </p>
                      </div>
                      <span class="text-orange-600 text-sm font-medium bg-orange-50 
                                   px-3 py-1 rounded-full">Pending</span>
                    <% } %>
                  </div>
                <% }) %>
              </div>
            <% } %>
          </div>
        <% }) %>
      </div>
    </div>

    <!-- ─── WEEKLY ADHERENCE ──────────────────────────── -->
    <div class="bg-white rounded-xl border border-gray-200 p-5 shadow-sm mb-8">
      <h2 class="text-xl font-bold text-gray-800 mb-5">
        📊 Weekly Adherence (Last 7 Days)
      </h2>

      <% if (medicines.length === 0) { %>
        <p class="text-gray-400 text-sm">No medicines added yet.</p>
      <% } else { %>
        <div class="space-y-4">
          <% medicines.forEach(med => { %>
            <div>
              <div class="flex justify-between items-center mb-1">
                <span class="font-medium text-gray-700">
                  <%= med.name %>
                  <span class="text-gray-400 font-normal text-sm">(<%= med.dosage %>)</span>
                </span>
                <span class="text-sm font-bold
                  <%= adherence[med._id] >= 70 ? 'text-green-600' : 
                      adherence[med._id] >= 40 ? 'text-orange-500' : 'text-red-500' %>">
                  <%= adherence[med._id] %>%
                </span>
              </div>
              <div class="w-full bg-gray-100 rounded-full h-3">
                <div class="h-3 rounded-full transition-all
                  <%= adherence[med._id] >= 70 ? 'bg-green-500' : 
                      adherence[med._id] >= 40 ? 'bg-orange-400' : 'bg-red-400' %>"
                  style="width: <%= adherence[med._id] %>%">
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

    <!-- ─── AI INSIGHTS ───────────────────────────────── -->
    <div class="bg-white rounded-xl border border-gray-200 p-5 shadow-sm mb-8">
      <h2 class="text-xl font-bold text-gray-800 mb-4">🧠 AI Insights</h2>
      <% if (parents.length === 0) { %>
        <p class="text-gray-400 text-sm">No parents added yet.</p>
      <% } else { %>
        <div class="grid grid-cols-1 gap-3">
          <% parents.forEach(parent => { %>
            <a href="/insights/<%= parent._id %>"
               class="flex items-center justify-between p-4 bg-purple-50 
                      hover:bg-purple-100 rounded-lg border border-purple-100 transition">
              <div>
                <p class="font-medium text-purple-800"><%= parent.name %></p>
                <p class="text-sm text-purple-500">View pattern analysis & symptom correlation</p>
              </div>
              <span class="text-purple-600 text-xl">→</span>
            </a>
          <% }) %>
        </div>
      <% } %>
    </div>

  </div>
</body>
</html>